# Supabase: Project Settings > Database > Connection string (use the pooler URI)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters
FRONTEND_URL=http://localhost:3000
# false on http://localhost; true in production (https)
COOKIE_SECURE=false
# lax if frontend and API share a site; none (with COOKIE_SECURE=true) if on different domains
COOKIE_SAMESITE=lax
# Leave SMTP_HOST empty in dev: emails are printed to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerQuest <no-reply@example.com>
