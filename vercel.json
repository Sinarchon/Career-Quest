{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "next"
    },
    {
      "src": "backend/main.py",
      "use": "python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/main.py",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ],
  "env": {
    "API_ORIGIN": "@api_origin",
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "ANTHROPIC_API_KEY": "@anthropic_api_key"
  }
}